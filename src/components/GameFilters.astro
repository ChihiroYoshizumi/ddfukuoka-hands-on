---
import type { Category, Publisher } from '../types/game';

/** Props for the game filter controls. */
interface Props {
    /** Categories offered as checkboxes. */
    categories: Category[];
    /** Publishers offered in the select. */
    publishers: Publisher[];
    /** Total number of games, used for the initial count text. */
    total: number;
}

const { categories, publishers, total } = Astro.props;
const focus = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    class="mb-6 bg-slate-800/60 border border-slate-700/50 rounded-xl p-4 space-y-4"
    aria-label="Filter games"
    data-testid="game-filters"
>
    <fieldset>
        <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label class="cursor-pointer">
                    <input
                        type="checkbox"
                        class="peer sr-only"
                        name="category"
                        value={category.id}
                        data-testid={`filter-category-${category.id}`}
                    />
                    <span class="inline-block text-sm px-3 py-1 rounded-full border border-slate-600 text-slate-300 transition-colors hover:border-blue-500 peer-checked:bg-blue-600 peer-checked:border-blue-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500">
                        {category.name}
                    </span>
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="publisher-filter" class="block text-sm font-medium text-slate-300 mb-2">Publisher</label>
            <select
                id="publisher-filter"
                name="publisher"
                class={`bg-slate-900 text-slate-100 border border-slate-600 rounded-lg px-3 py-2 text-sm ${focus}`}
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
        </div>
        <button
            type="button"
            class={`text-sm px-3 py-2 rounded-lg border border-slate-600 text-slate-300 hover:bg-slate-700 transition-colors ${focus}`}
            data-testid="filter-clear"
        >
            Clear filters
        </button>
        <p class="text-sm text-slate-400 ml-auto" role="status" aria-live="polite" data-testid="filter-count">
            Showing {total} of {total} games
        </p>
    </div>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const noResults = document.querySelector<HTMLElement>('[data-testid="no-results"]');
    const count = document.querySelector<HTMLElement>('[data-testid="filter-count"]');

    if (form && grid && count) {
        const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]')!;
        const checkboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));

        /** Shows only cards matching the selected categories and publisher, then updates the count. */
        const apply = (): void => {
            const selected = new Set(checkboxes.filter((c) => c.checked).map((c) => c.value));
            let visible = 0;
            for (const card of cards) {
                const matchesCategory = selected.size === 0 || selected.has(card.dataset.categoryId ?? '');
                const matchesPublisher = publisher.value === '' || card.dataset.publisherId === publisher.value;
                const show = matchesCategory && matchesPublisher;
                card.hidden = !show;
                if (show) visible++;
            }
            grid.hidden = visible === 0;
            noResults?.classList.toggle('hidden', visible !== 0);
            count.textContent = `Showing ${visible} of ${cards.length} games`;
        };

        form.addEventListener('change', apply);
        form.addEventListener('submit', (e) => e.preventDefault());
        form.querySelector('[data-testid="filter-clear"]')?.addEventListener('click', () => {
            checkboxes.forEach((c) => (c.checked = false));
            publisher.value = '';
            apply();
        });
    }
</script>
